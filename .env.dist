# ========================================
#   KurupUserbot - Environment Variables
#   Telegram Userbot Configuration
# ========================================

# Get these from https://my.telegram.org
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627

# sqlite/sqlite3 or mongo/mongodb
DATABASE_TYPE={db_type}
# file name for sqlite3, database name for mongodb
DATABASE_NAME={db_name}

# only for mongodb
DATABASE_URL={db_url}

# STRING SESSION - if not set, it will be generated at startup
STRINGSESSION={string_session}

# Second session for music bot
# Set if you want to use the music bot feature
SECOND_SESSION={second_session}

# PM LIMIT for AntiPM plugin
PM_LIMIT={pm_limit}

QUOTES_API={quotes_api}

# apiflash api key - only for webshot plugin
APIFLASH_KEY={api_flash_key}

# rmbg api key - only for removebg plugin
RMBG_KEY={rmbg_key}

# VT api key - only for VirusTotal plugin
VT_KEY={vt_key}

# gemini api key - only for gemini AI plugin
GEMINI_KEY={gemini_key}

# cohere api key - only for cohere AI plugin
COHERE_KEY={cohere_key}

# openai api key - for ChatGPT plugin
OPENAI_KEY={openai_key}

# Command prefix (default: .)
COMMAND_PREFIX=.

# Enable test server mode (true/false)
TEST_SERVER=false
