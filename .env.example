# ========================================
#   KurupUserbot - Quick Start Config
# ========================================

# Get from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash_here

# Database: use sqlite3 for local, mongodb for cloud
DATABASE_TYPE=sqlite3
DATABASE_NAME=kurupub

# For MongoDB only (leave empty for sqlite3)
DATABASE_URL=

# Session string (auto-generated if empty)
STRINGSESSION=

# PM Limit (Anti-spam)
PM_LIMIT=4

# Optional AI Keys
GEMINI_KEY=
COHERE_KEY=
OPENAI_KEY=
